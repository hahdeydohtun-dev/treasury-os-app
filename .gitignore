# ==================================================
# Treasury OS - root .gitignore
# ==================================================

# --- Secrets / environment files ---
# Never commit real environment configuration - only the .example
# templates are tracked.
.env
.env.*
!.env.example
!.env.local.example

backend/.env
frontend/.env.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Alembic (generated at runtime, not the migration scripts themselves) ---
backend/alembic/versions/__pycache__/

# --- Node / frontend ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/

# --- Logs ---
*.log
npm-debug.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
