# ==================================================
# Treasury OS - environment configuration template
# Copy to backend/.env (backend) and frontend/.env.local (frontend),
# then fill in real values. Never commit real secrets.
# ==================================================

# --- Backend (backend/.env) ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://treasury:treasury@localhost:5432/treasury_os
DATABASE_URL_SYNC=postgresql+psycopg2://treasury:treasury@localhost:5432/treasury_os
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CORS_ORIGINS=["http://localhost:3000"]
AI_COPILOT_ENABLED=false
ANTHROPIC_API_KEY=

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
